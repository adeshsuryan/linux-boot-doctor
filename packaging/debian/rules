#!/usr/bin/make -f
export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_build:
	cargo build --release -p linux-boot-doctor

override_dh_auto_install:
	install -D -m 0755 target/release/linux-boot-doctor debian/linux-boot-doctor/usr/bin/linux-boot-doctor

override_dh_auto_test:
	cargo test -p boot-doctor-core
