# Maintainer: Adesh Suryan <adeshsuryan2005@gmail.com>
pkgname=linux-boot-doctor
pkgver=0.1.0
pkgrel=1
pkgdesc="Diagnose slow Linux boots from systemd-analyze evidence (read-only CLI)"
arch=('x86_64' 'aarch64')
url="https://github.com/adeshsuryan/linux-boot-doctor"
license=('MIT')
depends=('gcc-libs')
makedepends=('cargo' 'rust')
source=("$pkgname-$pkgver.tar.gz::https://github.com/adeshsuryan/linux-boot-doctor/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu" || cargo fetch --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo build --release --locked -p linux-boot-doctor || cargo build --release -p linux-boot-doctor
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --release -p boot-doctor-core || true
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/linux-boot-doctor" "$pkgdir/usr/bin/linux-boot-doctor"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
